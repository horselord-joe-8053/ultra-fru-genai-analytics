# Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
DB_PASSWORD=postgres
PGDATABASE=fru_db

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Claude Configuration
CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# AWS Credentials for Admin (Infrastructure Operations)
AWS_ADMIN_ACCESS_KEY_ID=your-admin-access-key-id
AWS_ADMIN_SECRET_ACCESS_KEY=your-admin-secret-access-key

# AWS Credentials for Bedrock (Application Runtime)
AWS_BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key-id
AWS_BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-access-key

# AWS Profile Selection
AWS_PROFILE=admin  # For infrastructure scripts (default)

# Region
AWS_REGION=us-east-1

# Bedrock related
# Primary: Inference Profile ID (for Claude 3.5 and newer models)
AWS_BEDROCK_INFERENCE_PROFILE_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Fallback: Model ID (for ON_DEMAND models like Claude 3)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Terraform State Bucket (for AWS deployments)
# S3 bucket name for storing Terraform remote state files (records the current state of your infrastructure)
# Format: <PROJ_NAME>-terraform-state-<ACCOUNT_ID> (project convention - you can define this format in .env)
# Must be globally unique across ALL AWS accounts worldwide (not just within your account)
# Replace <ACCOUNT_ID> with your actual AWS account ID (found via `aws sts get-caller-identity` or AWS Console)
# Example: fru-terraform-state-123456789012
# The bucket is created automatically by deployment scripts if it doesn't exist
TF_STATE_BUCKET=<PROJ_NAME>-terraform-state-<ACCOUNT_ID>
# Container Image (will be set after Step 7)
# use: CONTAINER_IMAGE=<account-id>.dkr.ecr.<AWS_REGION>.amazonaws.com/fru-api:latest

# Optional: AWS Credentials (for local development only)
# If not set, boto3 will use ~/.aws/credentials or IAM role
# For production, use IAM roles instead of credentials
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=...  # If using temporary credentials

# Optional: Data Paths
# FRU_CSV_PATH=data/raw/fridge_sales_with_rating.csv

# Optional: Analytics Scheduler (requires Spark + Delta table)
ENABLE_ANALYTICS_SCHEDULER=true
ANALYTICS_SCHEDULER_INTERVAL_SECONDS=180
# SPARK_HOME=/path/to/spark  # Optional, if spark-submit not in PATH
# DELTA_TABLE_PATH=data/delta/fru_sales

LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
OPENAI_EMBED_MODEL=text-embedding-3-small

# Agent-based query processing (single source of truth)
USE_AGENT_QUERY=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# Container image prefix (will be replaced with ECR URI for AWS deployments)
# For local deployments, this can be a simple identifier
IMAGE_PREFIX=fru-api-img-default-prefix

LOCAL_SERVER_PORT=5001

# Frontend polling frequency for Batch Analytics panel (seconds)
VITE_FRONTEND_POLL_FREQUENCY_IN_SEC=60
# Batch Analytics Limits
NUM_FOR_BATCH_ANALYTICS_TOP_SPARK_COMPUTE=20  # How many items Spark computes/stores
NUM_FOR_BATCH_ANALYTICS_TOP_QUERY=4           # How many items API returns to frontend
# Spark + Delta Lake Configuration (REQUIRED)
DELTA_LAKE_PACKAGE=io.delta:delta-spark_2.13:4.0.0
DELTA_TABLE_PATH=data/delta/fru_sales

# Spark version (for reference/documentation, should match Dockerfile.api)
SPARK_VERSION=4.0.1
HADOOP_VERSION=3
DELTA_LAKE_VERSION=4.0.0
SCALA_VERSION=2.13
